# ============================================================
# MCP Test Script Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# 
# NEVER commit .env to version control — it contains secrets!
# ============================================================

# SAP Identity Zone (e.g., "abc12345")
IDENTITY_ZONE=ABC12345

# Virtual host where MCP server is running (e.g., "mcp-server.example.com")
VIRTUAL_HOST=mcp-server.example.com

# MCP endpoint path (e.g., "/mcp" or "/tools/mcp")
MCP_PATH=mcp

# Region for authentication endpoint (eu10, us10, ap11, etc.)
AUTH_REGION=eu10

# OAuth Client ID (will be prompted if not set)
# SAP_MCP_CLIENT_ID=your-client-id-here

# OAuth Client Secret (will be prompted if not set)
# SAP_MCP_CLIENT_SECRET=your-client-secret-here
